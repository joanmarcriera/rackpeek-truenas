# Copy this file to docker/.env and fill in your values.
# docker compose --env-file docker/.env up -d

# ── Data paths ────────────────────────────────────────────────────────────────
# Host path where RackPeek stores its config.yaml.
# Point this at a ZFS dataset so config survives container updates.
# Inside the container this is always /app/config.
CONFIG_ROOT=/mnt/MainPool/rackpeek/config

# ── Ports ─────────────────────────────────────────────────────────────────────
# Web UI port (default: 8080).
WEB_PORT=8080

# ── API key (optional) ────────────────────────────────────────────────────────
# Set this to enable the REST inventory API with key authentication.
# Leave empty to disable the API (the web UI is always available).
# Header: X-Api-Key: <value>
RPK_API_KEY=

# ── Image version ─────────────────────────────────────────────────────────────
# Pin to a specific release tag for production stability.
# See: https://hub.docker.com/r/aptacode/rackpeek/tags
RACKPEEK_VERSION=latest
